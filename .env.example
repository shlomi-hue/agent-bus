# agent-bus environment. Copy to .env for local runs; set the same names in Vercel for production.
# Placeholders only. Never commit real values.

# --- Database: pick ONE of DATABASE_URL (local / any Postgres) or the Supabase pair (Vercel) ---

# Postgres URL. Local default matches docker-compose.yml (port 54329). If set, it wins over Supabase.
# Leave unset on Vercel and use the Supabase pair below.
DATABASE_URL=postgres://agent_bus:agent_bus@127.0.0.1:54329/agent_bus

# Supabase project URL (Dashboard → Connect, or Settings → API Keys).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase secret key (sb_secret_...) or legacy service_role JWT. Server-side only; never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional alias, used only when SUPABASE_SERVICE_ROLE_KEY is unset.
# SUPABASE_SECRET_KEY=your-secret-key

# --- Secrets ---

# Required for `npm run admin` and `npm run db:migrate`. At least 16 characters. Generate: openssl rand -base64 32
ADMIN_SECRET=replace-with-a-long-random-string
# Required in production: Vercel sends `Authorization: Bearer <CRON_SECRET>` to the daily cron. Fails closed if unset.
CRON_SECRET=replace-with-another-long-random-string
# Required to use /chat. Owner password, at least 8 characters. Rotating it signs the owner out.
OWNER_PASSWORD=replace-with-the-owner-password

# --- Owner ---

# Optional. Agent slug of the human owner used by /chat and `admin ensure-owner`. Default: owner.
OWNER_NAME=owner

# --- Limits (all optional; defaults shown) ---

# Optional. Max reply hops in a direct thread. Integer 1–100.
MAX_HOPS=10
# Optional. Max message body size in bytes. Cannot exceed 16384.
MAX_BODY_BYTES=16384
# Optional. Tool calls allowed per agent per window.
RATE_LIMIT_MAX=30
# Optional. Rate-limit window in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
# Optional. Consecutive agent-only room posts before the room pauses for a human. Integer 1–100.
ROOM_AGENT_CAP=10
# Optional. Long-poll cap for wait_for_messages, integer 1–20. Keep under the function max duration.
# WAIT_MAX_SECONDS=8

# --- Owner notifications (optional; off when the URL is unset) ---

# Optional. HTTPS endpoint (ntfy, a small relay) that gets a signed POST when agents @mention the owner or post plans/results.
# OWNER_NOTIFY_URL=https://example.com/hooks/agent-bus-owner
# Optional. HMAC key for OWNER_NOTIFY_URL. Set it whenever you set the URL.
# OWNER_NOTIFY_SECRET=replace-with-a-random-string

# --- /chat live updates (optional) ---

# Optional. How long one /chat event-stream response stays open, ms (200–20000). Default 8000.
# CHAT_SSE_MS=8000
# Optional. How often that stream checks for changes, ms (50–5000). Default 1000.
# CHAT_SSE_POLL_MS=1000

# --- Local dev server (optional) ---

# Optional. Port for `npm run dev`. Default 43123.
PORT=43123
# Optional. Bind address for `npm run dev`. Default 0.0.0.0.
# HOST=127.0.0.1

# --- Set by the platform; normally do not set by hand ---

# Optional. "production" enables Secure cookies (also on when VERCEL is set).
# NODE_ENV=production
# Optional. Set automatically by Vercel; enables Secure cookies.
# VERCEL=1
