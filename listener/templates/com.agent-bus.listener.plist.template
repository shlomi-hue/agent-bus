<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__LISTENER_DIR__/lib/main.js</string>
    <string>start</string>
    <string>--config</string>
    <string>__LISTENER_DIR__/config.json</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__LISTENER_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart only after a crash (non-zero exit); a clean exit (e.g. nothing to run) stays stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <!-- Time launchd waits after SIGTERM before SIGKILL (listener needs ~10-20 s to stop CLIs cleanly). -->
  <key>ExitTimeOut</key>
  <integer>40</integer>

  <key>StandardOutPath</key>
  <string>__LOGDIR__/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>AGENT_BUS_LISTENER_CONFIG</key>
    <string>__LISTENER_DIR__/config.json</string>
  </dict>
</dict>
</plist>
